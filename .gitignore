# WordPress local dev (LocalWP). wp-config con credenciales locales y dumps de BD.
# Cualquier dump completo de WP contiene wp_users (hashes), emails y posibles
# tokens guardados en wp_options — fuera del repo siempre.
wp-config.php
wordpress-db.sql
wp-content.tar.gz

# Instalación WordPress completa (core + wp-config con RC_MANTIS_TOKEN + vendor).
# El código fuente del proyecto vive en wordpress/ — NUNCA en wp/.
# Auditoría A1/A2 (2026-05-29): wp/ traía 3119 ficheros (95% del repo) y el token
# Mantis filtrado en wp/wp-config.php. Instalar WP vía deploy, no versionarlo.
wp/

# Config server PHP — no pertenece al repo de aplicación (documentar valores en docs/).
/php.ini

# Scripts de despliegue al VPS — se conservan en local pero NUNCA se suben a GitHub.
scripts/server/upload-to-vps.ps1
scripts/server/deploy-ionos.sh
scripts/server/ops/deploy.sh

# Dumps/concatenados generados de la documentación (los originales viven en docs/).
