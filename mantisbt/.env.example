# MantisBT — variables para docker-compose (dev local).
# Copiar a .env y rellenar. NO subir el .env real al repo.

# Nombre de la base de datos de Mantis
MANTIS_DB_NAME=mantis

# Usuario de Mantis (NO usar root)
MANTIS_DB_USER=mantis

# Contraseña del usuario Mantis — generar algo aleatorio
MANTIS_DB_PASS=cambia_esto

# Salt para tokens API REST (32+ caracteres, aleatorio)
# Generar con: openssl rand -base64 32
MANTIS_SALT=cambia_esto_por_un_salt_largo_aleatorio

# Password de root de MySQL — solo en dev
MYSQL_ROOT_PASSWORD=cambia_esto_tambien
